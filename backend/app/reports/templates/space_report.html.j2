<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Impact Report – {{ space_id }}</title>
    <style>
      body {
        font-family: "Inter", Arial, sans-serif;
        margin: 0;
        padding: 32px;
        color: #1f2933;
        background: #ffffff;
        line-height: 1.6;
      }

      header {
        border-bottom: 2px solid #06b6d4;
        padding-bottom: 16px;
        margin-bottom: 24px;
      }

      h1 {
        font-size: 28px;
        margin: 0 0 8px 0;
      }

      h2 {
        font-size: 20px;
        color: #0f172a;
        margin-top: 28px;
        margin-bottom: 12px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 16px;
      }

      th {
        text-align: left;
        background: #f1fbfd;
        color: #036c7c;
        padding: 12px;
        font-size: 12px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      td {
        padding: 12px;
        border-bottom: 1px solid #e2e8f0;
      }

      .badge {
        display: inline-block;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 11px;
        font-weight: 600;
        background: rgba(6, 182, 212, 0.12);
        color: #036c7c;
      }

      .note {
        font-size: 12px;
        color: #475569;
        margin-top: 4px;
      }

      footer {
        font-size: 11px;
        color: #64748b;
        border-top: 1px solid #e2e8f0;
        margin-top: 32px;
        padding-top: 12px;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Impact Overview – {{ space_id }}</h1>
      <div class="badge">Prepared {{ generated_at.strftime("%d %b %Y %H:%M UTC") }}</div>
      {% if inputs.prepared_by %}
      <div class="note">Prepared by {{ inputs.prepared_by }}</div>
      {% endif %}
    </header>

    <section>
      <h2>Key Metrics</h2>
      <table>
        <thead>
          <tr>
            <th>Metric</th>
            <th>Value</th>
            <th>Change</th>
            <th>Unit</th>
          </tr>
        </thead>
        <tbody>
          {% for kpi in kpis %}
          <tr>
            <td>{{ kpi.label }}</td>
            <td>{{ "{:,.2f}".format(kpi.value) if kpi.unit == "ratio" else "{:,.0f}".format(kpi.value) }}</td>
            <td>
              {% if kpi.delta > 0 %}
              ▲ {{ "{:,.1f}%".format(kpi.delta * 100) }}
              {% elif kpi.delta < 0 %}
              ▼ {{ "{:,.1f}%".format(abs(kpi.delta) * 100) }}
              {% else %}
              – steady –
              {% endif %}
            </td>
            <td>{{ kpi.unit }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Narrative</h2>
      <p>{{ narrative }}</p>
    </section>

    <section>
      <h2>Series Insights</h2>
      {% for serie in series %}
      <h3>{{ serie.label }}</h3>
      <table>
        <thead>
          <tr>
            <th>Bucket</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          {% for point in serie.points %}
          <tr>
            <td>{{ point.x }}</td>
            <td>{{ "{:,.2f}".format(point.y) }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endfor %}
      {% if series_meta.note %}
      <div class="note">{{ series_meta.note }}</div>
      {% endif %}
    </section>

    <footer>
      Generated via ImpactView first-party analytics. Future versions will embed AI-generated narrative once enabled.
    </footer>
  </body>
</html>
